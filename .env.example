# Copy this file to .env.local and fill in your values.
# .env.local is loaded automatically by Next.js and is gitignored.
#
# ⚠️  NEXT_PUBLIC_* variables are baked into the JS bundle at build time (npm run build).
#     Changing them after build has no effect — you must rebuild the image.

# Base URL of the backend load balancer / API gateway.
# For local dev: http://localhost:8080
# For AWS: your ELB or ALB URL, e.g. https://my-alb-123456.us-east-1.elb.amazonaws.com
NEXT_PUBLIC_DEV_URL=

# Google Analytics 4 Measurement ID (optional).
# Leave empty to disable analytics entirely.
# Format: G-XXXXXXXXXX
# Get this from: GA4 → Admin → Data Streams → your web stream
NEXT_PUBLIC_GTAG=

# Keycloak configuration (url comes from NEXT_PUBLIC_DEV_URL above)
NEXT_PUBLIC_KEYCLOAK_REALM=
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=

# Disable TLS verification for local dev only. Never set to 0 in production.
NODE_TLS_REJECT_UNAUTHORIZED=1
