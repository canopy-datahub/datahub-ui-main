# Copy this file to .env.local for local development.
# For AWS deployment, copy to .env.production instead (used by deploy.py).
#
# .env.local is loaded automatically by Next.js and is gitignored.
#
# ⚠️  NEXT_PUBLIC_* variables are baked into the JS bundle at build time (npm run build).
#     Changing them after build has no effect — you must rebuild the image.

# Base URL of the backend ALB / API gateway (for API routing and download links).
# For AWS: https://canopy.stanford.edu
# For local dev: http://localhost:8080
NEXT_PUBLIC_BACKEND_URL=

# Keycloak server URL.
# For AWS: https://canopy.stanford.edu (ALB routes /realms/* to Keycloak)
# For local Keycloak in Docker: http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_URL=

# Local development: use separate ports for each service (localhost:808x).
# Set to true when running Spring Boot services natively in IntelliJ.
# Leave empty for AWS/Docker deployments.
# NEXT_PUBLIC_BACKEND_LOCAL_PORTS=true

# Google Analytics 4 Measurement ID (optional, leave empty to disable).
NEXT_PUBLIC_GTAG=

# Keycloak configuration
NEXT_PUBLIC_KEYCLOAK_REALM=
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=

# Disable TLS verification for local dev only. Always 1 in production.
NODE_TLS_REJECT_UNAUTHORIZED=1
