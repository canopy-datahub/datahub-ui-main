# Production environment configuration for AWS deployment.
# Used by deploy.py when building the Docker image.
#
# ⚠️  NEXT_PUBLIC_* variables are baked into the JS bundle at build time.

# Base URL of the backend ALB / API gateway (for API routing and download links).
NEXT_PUBLIC_BACKEND_URL=https://canopy.stanford.edu

# Keycloak server URL (in AWS, same ALB routes /realms/* to Keycloak).
NEXT_PUBLIC_KEYCLOAK_URL=https://canopy.stanford.edu

# Local development: use separate ports for each service (localhost:808x).
# Must NOT be set for AWS deployments.
NEXT_PUBLIC_BACKEND_LOCAL_PORTS=

# Google Analytics 4 Measurement ID (optional, leave empty to disable).
NEXT_PUBLIC_GTAG=

# Keycloak configuration
NEXT_PUBLIC_KEYCLOAK_REALM=CANOPY
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=canopy-client

# TLS verification. Always 1 in production.
NODE_TLS_REJECT_UNAUTHORIZED=1
